runAlias unloadCFGAll +freeCursor wait\10 esc

## NOP_792 (NOP placeholder to escape loops)

## basic
# guarded by pressing
alias jump_once +jump wait\1 -jump
# consume click_count
alias drop_single +drop -drop
alias tap_use +use -use

## loops (MUST contain a wait\n whose n > 0 -> StackOverflow)
alias +loop_tap_use +silent alias\loop_tap_use_iter;tap_use;wait\1;builtinRunAlias\loop_tap_use_iter -silent builtinRunAlias\loop_tap_use_iter
alias -loop_tap_use +silent alias\loop_tap_use_iter;NOP_792 -silent
alias +loop_tower var\lastPitch\pitch setPitch\90 +jump +loop_tap_use
alias -loop_tower -loop_tap_use -jump setPitch\lastPitch
alias +loop_attack_sword +silent alias\loop_attack_sword_iter;+attack;wait\1;-attack;wait\13;builtinRunAlias\loop_attack_sword_iter -silent builtinRunAlias\loop_attack_sword_iter
alias -loop_attack_sword +silent alias\loop_attack_sword_iter;NOP_792 -silent

# `+loop_drop wait\N -loop_drop` drops N+1 items
alias +loop_drop +silent alias\loop_drop_iter;drop_single;wait\1;builtinRunAlias\loop_drop_iter -silent builtinRunAlias\loop_drop_iter
alias -loop_drop +silent alias\loop_drop_iter;NOP_792 -silent

## movement
# `+hop wait\N -hop`: walk N ticks auto-jumping 1-high steps
alias +hop +jump +forward +sprint
alias -hop -jump -forward -sprint

## `var\src\c<N> [var\cnt\<D>] split` (peels 1, or cnt+1).
## RESULT: peeled pile in smallest EMPTY inventory slot -> move manually.
## REQUIREMENTS: src must be an **INPUTABLE** container slot; container screen open; on_ground; not on edge;
##               +freeCursor; NO partial same-type stacks in inventory slots; cnt < stack count.
## TIMING: 42 [+ cnt]
var cnt 0
alias split var\lastPitch\pitch setPitch\90 swapSlot\src\14 wait\2 +loop_drop wait\cnt -loop_drop var\cnt\0 wait\2 setPitch\lastPitch swapSlot\14\src wait\38
